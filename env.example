# ===== WHATSAPP BUSINESS API (Meta) =====
WHATSAPP_GRAPH_API=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_APP_ID=tu_app_id
WHATSAPP_APP_SECRET=tu_app_secret
WHATSAPP_ACCESS_TOKEN=token_de_acceso_permanente
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token_secreto_que_el_webhook_verifica
WHATSAPP_MEDIA_PATH=uploads/whatsapp
# Solo para desarrollo local:
WHATSAPP_TEST_PHONE_NUMBER_ID=

# ===== GROQ API =====
GROQ_API_KEY=gsk_...
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_CHAT_FALLBACK=llama-3.1-8b-instant
GROQ_MODEL_TRANSCRIBE=whisper-large-v3-turbo

# ===== NEON =====
DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ===== APLICACIÓN =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
WEBHOOK_TIMEOUT_SECONDS=25

